{
  "name": "renovation-energie",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-google-maps/api": "^2.20.6",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "cra-template": "1.2.0",
    "framer-motion": "^12.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.6.2",
    "react-scripts": "^5.0.1",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "prestart": "node scripts/make-blog-thumbs.mjs",
    "start": "react-scripts start",
    "prebuild": "node scripts/make-blog-thumbs.mjs",
    "build": "react-scripts build",
    "postbuild": "react-snap",
    "thumbs": "node scripts/make-blog-thumbs.mjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "optimize-images": "imagemin public/*.{jpg,png,webp} --plugin=mozjpeg --plugin=pngquant --plugin=webp --out-dir=public/"
  },
  "reactSnap": {
    "include": [
      "/",
      "/blog",
      "/mentions-legales",
      "/confidentialite",
      "/dpe-gratuit",
      "/pompe-a-chaleur",
      "/pompe-a-chaleur-classique",
      "/blog/valorisation-immobiliere-renovation-energetique"
    ],
    "skipThirdPartyRequests": true,
    "inlineCss": false,
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false,
      "collapseBooleanAttributes": true,
      "decodeEntities": true,
      "keepClosingSlash": true,
      "sortAttributes": true,
      "sortClassName": false
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.14",
    "imagemin": "^9.0.1",
    "imagemin-cli": "^8.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-webp": "^8.0.0",
    "postcss": "^8.4.21",
    "react-snap": "^1.23.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.3.2",
    "vercel": "^48.4.1"
  }
}
